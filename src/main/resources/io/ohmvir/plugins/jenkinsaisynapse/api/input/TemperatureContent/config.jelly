<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Temperature Content}" description="${%Controls randomness of model output. Generally either temperature or topk + topp is used, not both.}">
        <f:entry field="temperature">
            <f:number />
        </f:entry>
    </f:section>
</j:jelly>
