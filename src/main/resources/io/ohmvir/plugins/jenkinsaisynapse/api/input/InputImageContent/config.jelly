<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Input Image Content}">
        <j:if test="${instance.imageBase64 != null}">
            <img src="${instance.imageBase64}" alt="Image Preview" style="max-width: 100%; height: auto;" />
        </j:if>
        <j:if test="${instance.imageBase64 == null}">
            <p><em>No image available.</em></p>
        </j:if>
    </f:section>
</j:jelly>
