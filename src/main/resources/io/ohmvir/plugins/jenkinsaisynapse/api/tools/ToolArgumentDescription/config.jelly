<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Tool Argument Description}">
        <f:entry title="${%Argument Name}" field="name">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Argument Type}" field="typeName">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Argument Description}" field="description">
            <f:textbox />
        </f:entry>
    </f:section>
</j:jelly>
