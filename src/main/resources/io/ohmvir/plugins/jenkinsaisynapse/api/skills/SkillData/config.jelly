<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Skill Data}">
        <f:entry title="${%Skill Name}" field="skillName">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Skill Description}" field="skillDescription">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Skill License}" field="skillLicense">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Skill Compatibility}" field="skillCompatibility">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Skill Metadata}" field="skillMetadataPrettyYaml">
            <f:textarea />
        </f:entry>
        <f:entry title="${%Allowed Tools}" field="allowedTools">
            <ul>
                <j:forEach var="item" items="${instance.allowedTools}">
                    <li>${item}</li>
                </j:forEach>
            </ul>
        </f:entry>
        <f:entry title="${%Skill Text}" field="skillText">
            <f:textarea />
        </f:entry>
        <f:section title="${%Skill References}">
            <j:forEach var="entry" items="${instance.skillReferencesEntries}">
                <f:entry title="${entry.key}">
                    <span class="jenkins-text">${entry.value}</span>
                </f:entry>
            </j:forEach>
        </f:section>
    </f:section>
</j:jelly>
