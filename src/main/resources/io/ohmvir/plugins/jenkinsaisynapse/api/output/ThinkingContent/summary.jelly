<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Thinking Content}" description="${%What the model thought while producing its response. This is not the final response.}">
        <f:entry title="${%Thinking Text}">
            <pre style="white-space: pre-wrap;">${it.thinking}</pre>
        </f:entry>
    </f:section>
</j:jelly>
