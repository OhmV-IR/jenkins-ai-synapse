<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Tool Call Content}" description="${%A model's tool call}">
        <f:entry title="${%Tool Name}" field="name">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Tool Use Id}" field="toolUseId">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Tool Arguments}" field="argumentsPrettyJson">
            <f:textarea />
        </f:entry>
    </f:section>
</j:jelly>
