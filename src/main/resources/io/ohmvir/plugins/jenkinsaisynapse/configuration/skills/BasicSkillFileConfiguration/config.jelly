<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Skill ID}" field="skillId" description="${%The identifier by which the agents refer to the skill. Should generally be the same as the name of the skill.}">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Paste SKILL.md Content}" field="fileContent">
        <f:textarea codemirror-mode="markdown" />
    </f:entry>
</j:jelly>
