<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%AI Conversations}">
        <f:entry title="${%Days to keep stored conversations}" field="retentionDays"
                 description="${%Applies to conversations under JENKINS_HOME/conversations. Conversations recorded by the aiRequest step are kept and discarded with their build. 0 keeps conversations forever.}">
            <f:number min="0" default="30" />
        </f:entry>
    </f:section>
</j:jelly>
