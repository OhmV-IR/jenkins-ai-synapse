<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
    <l:layout title="${it.displayName}" permission="${it.requiredPermission}">
        <l:side-panel>
            <l:tasks>
                <l:task icon="symbol-arrow-back-outline plugin-ionicons-api" href="${rootURL}/manage" title="${%Back to manage Jenkins}" />
            </l:tasks>
        </l:side-panel>
        <l:main-panel>
            <h1>${it.displayName}</h1>
            <p>
                <j:choose>
                    <j:when test="${it.retentionDays > 0}">${%retention(it.retentionDays)}</j:when>
                    <j:otherwise>${%Stored conversations are kept forever.}</j:otherwise>
                </j:choose>
                ${%Conversations from the aiRequest step are shown on their build.}
            </p>
            <j:set var="conversations" value="${it.conversations}" />
            <j:choose>
                <j:when test="${empty conversations}">
                    <p><em>${%There are no stored conversations.}</em></p>
                </j:when>
                <j:otherwise>
                    <j:forEach var="conversation" items="${conversations}">
                        <st:include page="conversation.jelly" it="${conversation}" />
                    </j:forEach>
                </j:otherwise>
            </j:choose>
        </l:main-panel>
    </l:layout>
</j:jelly>
