<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Anthropic Client Configuration}" description="${%Configuration settings for the API client to use when calling an anthropic model}">
        <f:entry title="${%Timeout Seconds}" description="${%How long the client will wait for a response from the Anthropic API}" field="timeoutSeconds">
            <f:number min="0" />
        </f:entry>
    </f:section>
</j:jelly>
