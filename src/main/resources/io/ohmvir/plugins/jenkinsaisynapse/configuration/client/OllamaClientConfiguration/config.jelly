<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Ollama Client Configuration}" description="${%Settings for the Ollama Client to use when interfacing with the API}">
        <f:entry title="${%Timeout Seconds}" field="timeoutSeconds" description="${%How long to wait for the API call to complete before assuming failure}">
            <f:number min="0" />
        </f:entry>
        <f:entry title="${%Keep Alive Seconds}" field="keepAliveSeconds" description="${%How long should the model stay loaded in memory after the completion of the API call}">
            <f:number min="0" />
        </f:entry>
    </f:section>
</j:jelly>