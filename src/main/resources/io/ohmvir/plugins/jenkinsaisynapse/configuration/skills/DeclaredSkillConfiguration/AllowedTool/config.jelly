<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Tool Name}" description="${%Select the tool the model should be allowed to use}" field="toolName">
        <f:select />
    </f:entry>
    <f:entry>
        <div align="right">
            <f:repeatableDeleteButton value="${%Delete Tool}" />
        </div>
    </f:entry>
</j:jelly>
