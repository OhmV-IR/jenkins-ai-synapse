<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Gemini Client Configuration}" description="${%Configuration settings for the client calling the Gemini API to use}">
        <f:entry title="${%Timeout Seconds}" description="${%How long should the Gemini client wait for a response from the API before assuming request failure}" field="timeoutSeconds">
            <f:number min="0" />
        </f:entry>
    </f:section>
</j:jelly>
