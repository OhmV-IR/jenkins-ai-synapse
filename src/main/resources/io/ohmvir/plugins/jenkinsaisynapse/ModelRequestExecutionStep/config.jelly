<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Request Text}" field="requestText">
        <f:textarea />
    </f:entry>
    <f:entry title="${%System Prompt}" field="systemPrompt">
        <f:textarea />
    </f:entry>
    <f:entry title="${%Temperature}" field="temperature">
        <f:number min="0" step="any" />
    </f:entry>
    <f:entry title="${%Max Output Tokens}" field="maxOutputTokens">
        <f:number min="0" />
    </f:entry>
    <f:entry title="${%Model}" field="modelId" description="${%Leave on automatic to use the first model, in the order set on the Models page, that can handle the request}">
        <f:select />
    </f:entry>
</j:jelly>
