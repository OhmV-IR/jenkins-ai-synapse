<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

    <f:entry title="${%Skill Name}" field="skillName" description="${%The name for the skill}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill Description}" field="skillDescription" description="${%The description of the skill}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill License}" field="skillLicense" description="${%The legal license by which the skill is licensed}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill Compatability}" field="skillCompatability" description="${%The system requirements that the skills needs to function}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill Metadata}" field="skillMetadata" description="${%Metadata related to the skill for indexing and organization}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Allowed Tools}" field="allowedTools" description="${%The external tools the agent is permitted to use while executing the skill}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill Text}" field="skillText" description="${%The main body of the skill that informs the agent on how to behave and specializes them}">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Skill References}" field="skillReferences" description="${%Supporting media and templates the skill can use}">
        <f:textbox />
    </f:entry>

</j:jelly>