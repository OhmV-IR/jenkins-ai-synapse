<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%AI Code Review Settings}">
        <f:section title="${%Models}">
            <f:repeatableHeteroProperty field="models" hasHeader="true" addCaption="${%Add Model}"/>
        </f:section>
        <f:section title="${%Agent Configurations}">
            <f:repeatableHeteroProperty field="agentConfigurations" hasHeader="true" addCaption="${%Add Agent}"/>
        </f:section>
        <f:section title="${%Model Client Configurations}">
            <f:section title="${%Default Client Configuration}">
            <f:property field="defaultClientConfiguration"/>
            </f:section>
            <f:repeatableProperty field="clientConfigurations" />
        </f:section>
        <f:section title="${%Skills}">
            <f:repeatableHeteroProperty field="skills" hasHeader="true" addCaption="${%Add Skill}" />
        </f:section>
        <f:section title="${%Model Client Configurations}">
            <f:section title="${%Anthropic}">
                <f:property field="anthropicClientConfiguration" />
            </f:section>
            <f:section title="${%Gemini}">
                <f:property field="geminiClientConfiguration" />
            </f:section>
            <f:section title="${%Ollama}">
                <f:property field="ollamaClientConfiguration" />
            </f:section>
            <f:section title="${%OpenAI}">
                <f:property field="openAIClientConfiguration" />
            </f:section>
        </f:section>
    </f:section>
</j:jelly>
