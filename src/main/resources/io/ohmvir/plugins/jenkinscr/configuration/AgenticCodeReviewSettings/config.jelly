<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%AI Code Review Settings}">
        <f:section title="${%Models}">
            <f:repeatableHeteroProperty field="models" hasHeader="true" addCaption="${%Add Model}"/>
        </f:section>
        <f:section title="${%Agent Configurations}">
            <f:entry field="appendDefaults">
                <f:checkbox title="${%Append built-in default Agent Configurations to list on next save}"/>
            </f:entry>
            <f:repeatableHeteroProperty field="agentConfigurations" hasHeader="true" addCaption="${%Add Agent}"/>
        </f:section>
        <f:section title="${%Model Client Configurations}">
            <f:property field="defaultClientConfiguration"/>
            <f:repeatableHeteroProperty field="clientConfigurations" hasHeader="true"
                                        addCaption="${%Add Client Configuration}"/>
        </f:section>
    </f:section>
</j:jelly>
