<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Timeouts}">
        <f:entry field="timeoutSeconds"
                 description="${%How many seconds should a model client wait for the model to finish generating its response}">
            <f:number field="timeoutSeconds" value="${it.timeoutSeconds}" min="0"/>
        </f:entry>
    </f:section>
</j:jelly>
