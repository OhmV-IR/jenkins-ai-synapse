<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Open AI Client Configuration}" description="${%Settings for the client interfacing with the OpenAI API}">
        <f:entry title="${%Timeout Seconds}" field="timeoutSeconds" description="${%How long to wait for a response from the OpenAI API before assuming failure}">
            <f:number min="0" />
        </f:entry>
    </f:section>
</j:jelly>
