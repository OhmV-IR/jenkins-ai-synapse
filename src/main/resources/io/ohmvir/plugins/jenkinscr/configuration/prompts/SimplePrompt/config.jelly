<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Simple Prompt}">
        <f:entry title="${%Prompt Id}" field="promptId">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Prompt Text}" field="promptText">
            <f:textbox />
        </f:entry>
    </f:section>
</j:jelly>
