<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%System Prompt}" field="systemPrompt">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Temperature}" field="temperature">
        <f:number />
    </f:entry>
    <f:entry title="${%Max Output Tokens}" field="maxOutputTokensPerPrompt">
        <f:number />
    </f:entry>
    <f:entry title="${%Model selector}" field="modelName">
        <f:select />
    </f:entry>
    <f:entry title="${%Use Thinking}" field="useThinking">
        <f:checkbox />
    </f:entry>
</j:jelly>
