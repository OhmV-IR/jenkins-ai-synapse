<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
    <l:layout title="${it.displayName} Configuration">
        <st:include page="sidepanel.jelly" it="${it}" />
        <l:main-panel>
            <h1>${%Configure AI Code Review Project}</h1>
            <f:form method="post" action="configSubmit" name="config">
                <f:section title="${%AI Code Review Project Settings}">
                    <f:entry title="${%Display Name}" field="displayName">
                        <f:textbox value="${it.displayName}" />
                    </f:entry>
                </f:section>
                <f:bottomButtonBar>
                    <f:submit value="${%Save}" />
                </f:bottomButtonBar>
            </f:form>
        </l:main-panel>
    </l:layout>
</j:jelly>