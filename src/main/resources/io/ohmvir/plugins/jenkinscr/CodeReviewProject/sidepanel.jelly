<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
    <l:side-panel>
        <l:tasks>
            <l:task icon="symbol-settings" href="${rootURL}/${it.url}configure" title="${%Configure}" />
            <l:task icon="symbol-trash" href="${rootURL}/${it.url}delete" title="${%Delete}" />
        </l:tasks>
    </l:side-panel>
</j:jelly>