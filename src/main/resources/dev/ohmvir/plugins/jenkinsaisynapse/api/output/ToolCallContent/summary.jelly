<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Tool Call Content}" description="${%A model's tool call}">
        <f:entry title="${%Tool Name}">
            <f:readOnlyTextbox value="${it.name}" />
        </f:entry>
        <f:entry title="${%Tool Use Id}">
            <f:readOnlyTextbox value="${it.toolUseId}" />
        </f:entry>
        <f:entry title="${%Tool Arguments}">
            <pre style="white-space: pre-wrap;">${it.argumentsPrettyJson}</pre>
        </f:entry>
    </f:section>
</j:jelly>
