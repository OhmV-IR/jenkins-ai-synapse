<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Output File Content}">
        <j:if test="${instance.fileData != null}">
            <a href="download" class="jenkins-button">
                Download ${instance.fileId}
            </a>
        </j:if>
        <j:if test="${instance.fileData == null}">
            <p><em>No file data available.</em></p>
        </j:if>
    </f:section>
</j:jelly>
