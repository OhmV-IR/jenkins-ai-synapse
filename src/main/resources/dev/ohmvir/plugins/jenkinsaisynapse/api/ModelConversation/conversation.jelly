<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<!-- Renders one ModelConversation. Include with <st:include page="conversation.jelly" it="${conversation}"/> -->
<j:jelly xmlns:j="jelly:core" xmlns:i="jelly:fmt">
    <details class="jenkins-!-margin-bottom-3">
        <summary>
            <i:formatDate value="${it.createdDate}" type="both" dateStyle="medium" timeStyle="short" />
            <j:if test="${it.modelId != null}"> · ${it.modelId}</j:if>
            · ${it.entries.size()} ${%entries}
            · <code>${it.conversationId}</code>
        </summary>
        <table class="jenkins-table jenkins-table--small">
            <thead>
                <tr>
                    <th>${%Direction}</th>
                    <th>${%Type}</th>
                    <th>${%Content}</th>
                </tr>
            </thead>
            <tbody>
                <j:forEach var="entry" items="${it.entries}">
                    <tr>
                        <td>${entry.direction}</td>
                        <td>
                            ${entry.type}
                            <j:if test="${entry.toolName != null}"><br />${entry.toolName}</j:if>
                            <j:if test="${entry.successful == false}"><br />${%failed}</j:if>
                        </td>
                        <td>
                            <j:choose>
                                <j:when test="${entry.mimeType != null}">${entry.mimeType}, ${entry.sizeBytes} ${%bytes}</j:when>
                                <j:otherwise><pre style="white-space: pre-wrap; margin: 0">${entry.text}</pre></j:otherwise>
                            </j:choose>
                        </td>
                    </tr>
                </j:forEach>
            </tbody>
        </table>
    </details>
</j:jelly>
