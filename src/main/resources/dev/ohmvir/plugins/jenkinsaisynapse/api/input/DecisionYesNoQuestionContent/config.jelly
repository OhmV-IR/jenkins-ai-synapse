<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Decision Yes/No Question Content}" description="${%A yes/no question for a decision model, answered with the probability of yes}">
        <f:entry title="${%Question Name}" field="name">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Instructions}" field="instructions">
            <f:textarea />
        </f:entry>
        <f:entry title="${%Yes Outcome}" field="trueCriteria">
            <f:textbox />
        </f:entry>
        <f:entry title="${%No Outcome}" field="falseCriteria">
            <f:textbox />
        </f:entry>
    </f:section>
</j:jelly>
