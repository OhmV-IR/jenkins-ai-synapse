<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Tool Call Response Content}" description="${%Our response to the model's tool call}">
        <f:entry title="${%Tool Use Id}" field="toolUseId">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Success Status}" field="successful">
            <f:checkbox />
        </f:entry>
        <f:entry title="${%Response Content}" field="responseContent">
            <f:textarea />
        </f:entry>
    </f:section>
</j:jelly>
