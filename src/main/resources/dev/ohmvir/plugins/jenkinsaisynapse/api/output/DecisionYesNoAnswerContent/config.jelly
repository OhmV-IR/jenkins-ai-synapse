<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Decision Yes/No Answer Content}" description="${%A decision model's probability that the answer to a yes/no question is yes}">
        <f:entry title="${%Question Name}" field="questionName">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Probability of Yes}" field="probability">
            <f:number />
        </f:entry>
    </f:section>
</j:jelly>
