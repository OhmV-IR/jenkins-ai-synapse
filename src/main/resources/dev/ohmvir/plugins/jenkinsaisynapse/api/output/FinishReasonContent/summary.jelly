<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Finish Reason Content}" description="${%Why the model stopped its response}">
        <f:entry title="${%Reason}">
            <f:readOnlyTextbox value="${it.reason}" />
        </f:entry>
        <f:entry title="${%Provider Reason}">
            <f:readOnlyTextbox value="${it.providerReason}" />
        </f:entry>
    </f:section>
</j:jelly>
