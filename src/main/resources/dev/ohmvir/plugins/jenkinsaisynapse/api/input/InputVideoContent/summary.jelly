<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Input Video Content}" description="${%Video uploaded to the model}">
        <j:if test="${it.videoData != null}">
            <video controls="controls" width="640" height="360">
                <source src="video" type="${it.mimeType}" />
                Your browser does not support the video element.
            </video>
        </j:if>
        <j:if test="${it.videoData == null}">
            <p><em>No video data available.</em></p>
        </j:if>
    </f:section>
</j:jelly>
