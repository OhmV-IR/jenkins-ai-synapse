<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Prompt}" field="prompt">
        <f:textarea />
    </f:entry>
    <f:entry title="${%Base prompt}" field="promptId">
        <f:select />
    </f:entry>
    <f:entry title="${%Model}" field="model">
        <f:select />
    </f:entry>
    <f:entry field="returnDetails">
        <f:checkbox title="${%Return details}" />
    </f:entry>
    <f:advanced>
        <f:entry title="${%System prompt}" field="systemPrompt">
            <f:textarea />
        </f:entry>
        <f:entry title="${%Temperature}" field="temperature">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Max output tokens}" field="maxOutputTokens">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Thinking level}" field="thinkingLevel">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Top P}" field="topP">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Top K}" field="topK">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Output directory}" field="outputDir">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Timeout (seconds)}" field="timeout">
            <f:textbox />
        </f:entry>
        <f:entry title="${%Maximum steps}" field="maxSteps">
            <f:textbox />
        </f:entry>
        <f:entry field="expandEnvVars">
            <f:checkbox title="${%Expand environment variables}" />
        </f:entry>
        <f:entry field="quiet">
            <f:checkbox title="${%Do not log the request's progress}" />
        </f:entry>
    </f:advanced>
</j:jelly>
