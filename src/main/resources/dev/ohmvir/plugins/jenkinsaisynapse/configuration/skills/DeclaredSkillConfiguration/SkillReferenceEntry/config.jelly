<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%File Relative Path}" description="${%The path relative to the root of the skill folder, eg references/myfile.txt}" field="relativeFilePath">
        <f:textbox />
    </f:entry>
    <f:entry title="${%File Content}" description="${%The content of the file at the path}" field="fileContent">
        <f:textbox />
    </f:entry>
    <f:entry>
        <div align="right">
            <f:repeatableDeleteButton value="${%Delete Tool}" />
        </div>
    </f:entry>
</j:jelly>
